<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= place.title %> - <%= settings.site_name || 'Andurma Kəndi' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (gaId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaId %>');
  </script>
  <% } %>
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo">
      <% if (settings.logo) { %><img src="<%= settings.logo %>" alt="Logo" class="logo-img"><% } %>
      <div class="logo-text">
        <span class="logo-name"><%= settings.site_name || 'Andurma Kəndi' %></span>
        <span class="logo-tagline"><%= settings.site_tagline || 'QƏBƏLƏ RAYONU' %></span>
      </div>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/">Ana səhifə</a>
      <a href="/xeberler">Xəbərlər</a>
      <a href="/isler">Görülən işlər</a>
      <a href="/meqaleler">Məqalələr</a>
      <a href="/koshe">Köşə</a>
      <a href="/qalereya">Qalereya</a>
      <a href="/gormeli-yerler" class="active">Görməli yerlər</a>
      <a href="/haqqinda">Haqqında</a>
      <a href="/elaqe">Əlaqə</a>
    </nav>
    <button class="mobile-menu-btn" id="mobileMenuBtn"><span></span><span></span><span></span></button>
  </div>
</header>

<section class="single-content">
  <div class="container-narrow">
    <div class="breadcrumb">
      <a href="/">Ana səhifə</a> / <a href="/gormeli-yerler">Görməli yerlər</a> / <%= place.title %>
    </div>
    <h1 class="single-title"><%= place.title %></h1>
    <div class="single-meta">
      <% if (place.location) { %><span>📍 <%= place.location %></span><% } %>
      <span>👁️ <%= place.views || 0 %> baxış</span>
      <span>📅 <%= new Date(place.created_at).toLocaleDateString('az-AZ') %></span>
    </div>

    <% if (place.image) { %>
      <img src="<%= place.image %>" alt="<%= place.title %>" class="single-image">
    <% } %>

    <% if (place.description) { %>
      <div class="single-text"><%= place.description %></div>
    <% } %>

    <% if (place.youtube_link) { 
         let ytId = '';
         let ytUrl = place.youtube_link;
         if (ytUrl.includes('youtube.com/watch?v=')) {
           ytId = ytUrl.split('v=')[1].split('&')[0];
         } else if (ytUrl.includes('youtu.be/')) {
           ytId = ytUrl.split('youtu.be/')[1].split('?')[0];
         } else if (ytUrl.includes('youtube.com/embed/')) {
           ytId = ytUrl.split('embed/')[1].split('?')[0];
         }
         if (ytId) { %>
      <div class="single-video" style="margin: 32px 0;">
        <iframe width="100%" height="450" 
          src="https://www.youtube.com/embed/<%= ytId %>" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
          style="border-radius: 12px;">
        </iframe>
      </div>
    <% } } %>

    <% if (place.map_link) { %>
      <div class="map-container" style="margin-top: 32px;">
        <iframe src="<%= place.map_link %>" width="100%" height="400" style="border:0; border-radius: 12px;" allowfullscreen loading="lazy"></iframe>
      </div>
    <% } %>

    <div class="like-section">
      <button class="like-btn" onclick="likePlace(<%= place.id %>)">
        <span class="like-icon">❤️</span>
        <span>Bəyən</span>
        <span class="like-count" id="likeCount"><%= place.likes || 0 %></span>
      </button>
    </div>

    <a href="/gormeli-yerler" class="back-link">← Bütün görməli yerlər</a>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-bottom">
      <p><%= settings.footer_text || '© 2026 Andurma Kəndi — Bütün hüquqlar qorunur.' %></p>
      <a href="/admin/login" class="admin-link">Admin girişi</a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('mobileMenuBtn').addEventListener('click', function() {
    document.getElementById('mainNav').classList.toggle('active');
    this.classList.toggle('active');
  });
  function likePlace(id) {
    fetch('/like/place/' + id, { method: 'POST' })
      .then(r => r.json())
      .then(data => {
        if (data.success) document.getElementById('likeCount').textContent = data.likes;
      });
  }
</script>
</body>
</html>