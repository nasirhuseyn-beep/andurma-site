<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title><%= user ? 'İstifadəçini Redaktə Et' : 'Yeni İstifadəçi' %> - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users" class="active">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= user ? '✏️ İstifadəçini Redaktə Et' : '➕ Yeni İstifadəçi' %></h1>
    </div>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <form method="POST" action="<%= user ? '/admin/users/edit/' + user.id : '/admin/users/new' %>" class="post-form">
      <div class="form-group">
        <label>İstifadəçi adı</label>
        <input type="text" name="username" value="<%= user ? user.username : '' %>" required>
      </div>
      <div class="form-group">
        <label>Şifrə <%= user ? '(dəyişmək istəmirsinizsə boş buraxın)' : '' %></label>
        <input type="password" name="password" <%= user ? '' : 'required' %>>
      </div>
      <div class="form-group">
        <label>Ad, Soyad</label>
        <input type="text" name="full_name" value="<%= user ? user.full_name : '' %>">
      </div>
      <div class="form-group">
        <label>E-poçt</label>
        <input type="email" name="email" value="<%= user ? user.email : '' %>">
      </div>
      <div class="form-group">
        <label>Rol</label>
        <select name="role">
          <option value="editor" <%= user && user.role === 'editor' ? 'selected' : '' %>>Redaktor</option>
          <option value="super_admin" <%= user && user.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
        </select>
      </div>
      <% if (user) { %>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="active" <%= user.active ? 'checked' : '' %>> Aktiv
        </label>
      </div>
      <% } %>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
        <a href="/admin/users" class="btn">← Geri</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>