<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title><%= koshe ? 'Köşə Yazısını Redaktə Et' : 'Yeni Köşə Yazısı' %> - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe" class="active">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= koshe ? '✏️ Köşə Yazısını Redaktə Et' : '➕ Yeni Köşə Yazısı' %></h1>
    </div>
    <form method="POST" action="<%= koshe ? '/admin/koshe/edit/' + koshe.id : '/admin/koshe/new' %>" enctype="multipart/form-data" class="post-form">
      <div class="form-group">
        <label>Başlıq</label>
        <input type="text" name="title" value="<%= koshe ? koshe.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>Mətn</label>
        <textarea name="content" rows="12" required><%= koshe ? koshe.content : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Şəkil</label>
        <input type="file" name="image" accept="image/*">
        <% if (koshe && koshe.image) { %>
        <div class="current-file"><img src="<%= koshe.image %>" alt=""><small>Cari şəkil</small></div>
        <% } %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
        <a href="/admin/koshe" class="btn">← Geri</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>