<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article ? 'Məqaləni redaktə et' : 'Yeni məqalə' %> — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <div class="admin-brand">🌿 Andurma</div>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/news">📰 Xəbərlər</a>
      <a href="/admin/articles" class="active">📝 Məqalələr</a>
      <a href="/admin/koshe">✍️ Köşə</a>
      <a href="/admin/gallery">📸 Qalereya</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/messages">📧 Mesajlar</a>
      <% if (user && user.role === 'super_admin') { %>
        <a href="/admin/users">👥 İstifadəçilər</a>
        <a href="/admin/settings">⚙️ Sazlamalar</a>
      <% } %>
      <a href="/admin/password">🔒 Şifrə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1><%= article ? '✏️ Məqaləni redaktə et' : '➕ Yeni məqalə' %></h1>

      <form method="POST" enctype="multipart/form-data" class="post-form"
            action="<%= article ? '/admin/articles/edit/' + article.id : '/admin/articles/new' %>">

        <div class="form-group">
          <label>Başlıq *</label>
          <input type="text" name="title" placeholder="Məqalənin başlığı..."
                 value="<%= article ? article.title : '' %>" required>
        </div>

        <div class="form-group">
          <label>Mətn *</label>
          <textarea name="content" rows="18" placeholder="Məqaləni yazın..." required><%= article ? article.content : '' %></textarea>
        </div>

        <div class="form-group">
          <label>📷 Şəkil</label>
          <input type="file" name="image" accept="image/*">
          <% if (article && article.image) { %>
            <div class="current-file">
              <img src="<%= article.image %>" alt="">
              <small>Mövcud şəkil</small>
            </div>
          <% } %>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <%= article ? '💾 Yadda saxla' : '✅ Əlavə et' %>
          </button>
          <a href="/admin/articles" class="btn">❌ Ləğv et</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>