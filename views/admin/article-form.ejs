<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title><%= article && article.id ? 'Məqaləni Redaktə Et' : 'Yeni Məqalə' %> - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Quill Editor CSS -->
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">
  <style>
    .ql-container { font-size: 15px; min-height: 220px; }
    .ql-editor { min-height: 220px; }
    .ql-toolbar { border-radius: 6px 6px 0 0; }
    .ql-container { border-radius: 0 0 6px 6px; }
  </style>
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles" class="active">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= article && article.id ? '✏️ Məqaləni Redaktə Et' : '➕ Yeni Məqalə' %></h1>
    </div>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-error" style="background:#fdecea;color:#b3261e;border:1px solid #f5c6c3;padding:12px 16px;border-radius:8px;margin-bottom:16px;">
      ⚠️ <%= error %>
    </div>
    <% } %>
    <form id="articleForm" method="POST" action="<%= article && article.id ? '/admin/articles/edit/' + article.id : '/admin/articles/new' %>" enctype="multipart/form-data" class="post-form">
      <div class="form-group">
        <label>Başlıq</label>
        <input type="text" name="title" value="<%= article ? article.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>Mətn</label>
        <!-- Gizli input - Quill məzmunu buraya yazılacaq -->
        <input type="hidden" name="content" id="hiddenContent" value="">
        <!-- Quill editor -->
        <div id="quillEditor"></div>
      </div>
      <div class="form-group">
        <label>🎬 YouTube Linki (istəyə bağlı)</label>
        <input type="text" name="youtube_url" value="<%= article && article.youtube_url ? article.youtube_url : '' %>" placeholder="https://www.youtube.com/watch?v=...">
        <small style="color:#888">Tam YouTube linkini yapışdırın. Video məqalə səhifəsində göstəriləcək.</small>
      </div>
      <div class="form-group">
        <label>Şəkil</label>
        <input type="file" name="image" accept="image/*">
        <% if (article && article.image) { %>
        <div class="current-file"><img src="<%= article.image %>" alt=""><small>Cari şəkil</small></div>
        <% } %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
        <a href="/admin/articles" class="btn">← Geri</a>
      </div>
    </form>
  </main>
</div>

<!-- Quill Editor JS -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
  // Quill editorunu işə sal
  var quill = new Quill('#quillEditor', {
    theme: 'snow',
    placeholder: 'Məqalə mətnini buraya yazın...',
    modules: {
      toolbar: [
        [{ 'header': [1, 2, 3, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'align': [] }],
        ['blockquote'],
        ['link'],
        ['clean']
      ]
    }
  });

  // Mövcud məqalə redaktə edilərkən məzmunu Quill-ə yüklə
  <% if (article && article.content) { %>
  try {
    quill.root.innerHTML = <%- JSON.stringify(article.content).replace(/</g, '\\u003c') %>;
  } catch(e) {
    console.error('Quill load error:', e);
  }
  <% } %>

  // Quill dəyişdikcə hidden input-u dərhal yenilə
  quill.on('text-change', function() {
    document.getElementById('hiddenContent').value = quill.root.innerHTML;
  });

  // Form göndərilməzdən əvvəl son dəfə yenilə
  document.getElementById('articleForm').addEventListener('submit', function(e) {
    var content = quill.root.innerHTML;
    // Boş editor yoxlaması
    if (content === '<p><br></p>' || content.trim() === '') {
      content = '';
    }
    document.getElementById('hiddenContent').value = content;
    // Dəyərin yazıldığını yoxla
    console.log('Göndərilən məzmun uzunluğu:', content.length);
  });
</script>
</body>
</html>