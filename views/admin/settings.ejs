<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sayt Sazlamaları — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <div class="admin-brand">🌿 Andurma</div>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/news">📰 Xəbərlər</a>
      <a href="/admin/articles">📝 Məqalələr</a>
      <a href="/admin/koshe">✍️ Köşə</a>
      <a href="/admin/gallery">📸 Qalereya</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/messages">📧 Mesajlar</a>
      <a href="/admin/users">👥 İstifadəçilər</a>
      <a href="/admin/settings" class="active">⚙️ Sazlamalar</a>
      <a href="/admin/password">🔒 Şifrə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1>⚙️ Sayt Sazlamaları</h1>

      <% if (saved) { %>
        <p class="ok">✅ Dəyişikliklər yadda saxlanıldı!</p>
      <% } %>

      <form method="POST" enctype="multipart/form-data" class="post-form">

        <h3 class="form-section-title">🏠 Hero (Ana Səhifə)</h3>

        <div class="form-group">
          <label>Saytın adı</label>
          <input type="text" name="site_name" value="<%= settings.site_name || '' %>">
        </div>

        <div class="form-group">
          <label>Hero başlıq</label>
          <input type="text" name="hero_title" value="<%= settings.hero_title || '' %>">
        </div>

        <div class="form-group">
          <label>Hero alt yazı</label>
          <input type="text" name="hero_subtitle" value="<%= settings.hero_subtitle || '' %>">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>🖼️ Hero fon şəkli</label>
            <input type="file" name="hero_image" accept="image/*">
            <% if (settings.hero_image) { %>
              <div class="current-file">
                <img src="<%= settings.hero_image %>" style="max-width:200px;">
                <small>Mövcud fon</small>
              </div>
            <% } %>
          </div>
          <div class="form-group">
            <label>🌿 Logo</label>
            <input type="file" name="logo" accept="image/*">
            <% if (settings.logo) { %>
              <div class="current-file">
                <img src="<%= settings.logo %>" style="max-width:100px;">
                <small>Mövcud logo</small>
              </div>
            <% } %>
          </div>
        </div>

        <h3 class="form-section-title">ℹ️ Haqqında</h3>

        <div class="form-group">
          <label>Başlıq</label>
          <input type="text" name="about_title" value="<%= settings.about_title || '' %>">
        </div>

        <div class="form-group">
          <label>Mətn</label>
          <textarea name="about_text" rows="6"><%= settings.about_text || '' %></textarea>
        </div>

        <h3 class="form-section-title">📞 Əlaqə</h3>

        <div class="form-row">
          <div class="form-group">
            <label>Telefon</label>
            <input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>">
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="text" name="contact_email" value="<%= settings.contact_email || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label>Ünvan</label>
          <input type="text" name="contact_address" value="<%= settings.contact_address || '' %>">
        </div>

        <h3 class="form-section-title">🌐 Sosial Şəbəkələr</h3>

        <div class="form-group">
          <label>📘 Facebook</label>
          <input type="text" name="social_facebook" value="<%= settings.social_facebook || '' %>" placeholder="https://facebook.com/...">
        </div>
        <div class="form-group">
          <label>📸 Instagram</label>
          <input type="text" name="social_instagram" value="<%= settings.social_instagram || '' %>" placeholder="https://instagram.com/...">
        </div>
        <div class="form-group">
          <label>📺 YouTube</label>
          <input type="text" name="social_youtube" value="<%= settings.social_youtube || '' %>" placeholder="https://youtube.com/...">
        </div>

        <h3 class="form-section-title">🦶 Footer</h3>

        <div class="form-group">
          <label>Footer mətni</label>
          <input type="text" name="footer_text" value="<%= settings.footer_text || '' %>">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
          <a href="/" target="_blank" class="btn">👁️ Sayta bax</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>