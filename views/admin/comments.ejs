<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title>Şərhlər - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments" class="active">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>💬 Şərhlər</h1>
    </div>
    <% if (comments && comments.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Ad</th><th>Şərh</th><th>Növ</th><th>Status</th><th>Tarix</th><th>Əməliyyatlar</th></tr>
      </thead>
      <tbody>
        <% comments.forEach(item => { %>
        <tr class="<%= item.approved ? '' : 'row-pending' %>">
          <td><strong><%= item.name %></strong></td>
          <td class="comment-text"><%= item.text %></td>
          <td><%= item.content_type %></td>
          <td><% if (item.approved) { %><span class="status status-ok">Təsdiqlənib</span><% } else { %><span class="status status-pending">Gözləyir</span><% } %></td>
          <td><%= new Date(item.created_at).toLocaleDateString('az-AZ') %></td>
          <td>
            <div class="actions">
              <% if (!item.approved) { %>
              <form method="POST" action="/admin/comments/approve/<%= item.id %>" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-success">✅</button>
              </form>
              <% } %>
              <form method="POST" action="/admin/comments/delete/<%= item.id %>" style="display:inline;" onsubmit="return confirm('Əminsiniz?')">
                <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
      <p class="empty-message">Hələ şərh yoxdur.</p>
    <% } %>
  </main>
</div>
</body>
</html>