<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title>Şifrə Dəyişmə - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password" class="active">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>🔒 Şifrə Dəyişmə</h1>
    </div>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <% if (success) { %><div class="ok"><%= success %></div><% } %>
    <form method="POST" action="/admin/password" class="post-form">
      <div class="form-group">
        <label>Cari Şifrə</label>
        <input type="password" name="current_password" required>
      </div>
      <div class="form-group">
        <label>Yeni Şifrə</label>
        <input type="password" name="new_password" required>
      </div>
      <div class="form-group">
        <label>Yeni Şifrə (təkrar)</label>
        <input type="password" name="confirm_password" required>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
        <a href="/admin" class="btn">← Geri</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>