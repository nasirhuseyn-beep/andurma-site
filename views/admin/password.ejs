<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Şifrə Dəyişmə — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <div class="admin-brand">🌿 Andurma</div>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/news">📰 Xəbərlər</a>
      <a href="/admin/articles">📝 Məqalələr</a>
      <a href="/admin/koshe">✍️ Köşə</a>
      <a href="/admin/gallery">📸 Qalereya</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/messages">📧 Mesajlar</a>
      <% if (user && user.role === 'super_admin') { %>
        <a href="/admin/users">👥 İstifadəçilər</a>
        <a href="/admin/settings">⚙️ Sazlamalar</a>
      <% } %>
      <a href="/admin/password" class="active">🔒 Şifrə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1>🔒 Şifrə Dəyişmə</h1>

      <% if (error) { %>
        <p class="err">❌ <%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="ok">✅ <%= success %></p>
      <% } %>

      <form method="POST" class="post-form" style="max-width: 500px;">
        <div class="form-group">
          <label>Cari şifrə *</label>
          <input type="password" name="current_password" required>
        </div>
        <div class="form-group">
          <label>Yeni şifrə * (min 6 simvol)</label>
          <input type="password" name="new_password" required minlength="6">
        </div>
        <div class="form-group">
          <label>Yeni şifrə (təkrar) *</label>
          <input type="password" name="confirm_password" required minlength="6">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">🔒 Şifrəni dəyiş</button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>