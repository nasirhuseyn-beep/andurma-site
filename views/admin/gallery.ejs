<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Qalereya — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <div class="admin-brand">🌿 Andurma</div>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/news">📰 Xəbərlər</a>
      <a href="/admin/articles">📝 Məqalələr</a>
      <a href="/admin/koshe">✍️ Köşə</a>
      <a href="/admin/gallery" class="active">📸 Qalereya</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/messages">📧 Mesajlar</a>
      <% if (user && user.role === 'super_admin') { %>
        <a href="/admin/users">👥 İstifadəçilər</a>
        <a href="/admin/settings">⚙️ Sazlamalar</a>
      <% } %>
      <a href="/admin/password">🔒 Şifrə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <div class="admin-header">
        <h1>📸 Qalereya</h1>
        <a href="/admin/gallery/new" class="btn btn-primary">➕ Yeni foto/video</a>
      </div>

      <% if (gallery.length === 0) { %>
        <p class="empty-message">Hələ foto/video yoxdur.</p>
      <% } else { %>
        <div class="admin-gallery-grid">
          <% gallery.forEach(item => { %>
            <div class="admin-gallery-item">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.title %>">
              <% } else if (item.video) { %>
                <video src="<%= item.video %>"></video>
              <% } %>
              <div class="admin-gallery-info">
                <strong><%= item.title %></strong>
                <% if (item.description) { %>
                  <small><%= item.description %></small>
                <% } %>
              </div>
              <form method="POST" action="/admin/gallery/delete/<%= item.id %>" class="admin-gallery-delete">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmək istəyirsiniz?');">🗑️ Sil</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>