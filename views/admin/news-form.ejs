<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title><%= news ? 'Xəbəri Redaktə Et' : 'Yeni Xəbər' %> - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news" class="active">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1><%= news ? '✏️ Xəbəri Redaktə Et' : '➕ Yeni Xəbər' %></h1>
    </div>
    <form method="POST" action="<%= news ? '/admin/news/edit/' + news.id : '/admin/news/new' %>" enctype="multipart/form-data" class="post-form">
      <div class="form-group">
        <label>Başlıq</label>
        <input type="text" name="title" value="<%= news ? news.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>Kateqoriya</label>
        <select name="category">
          <option value="yol" <%= news && news.category === 'yol' ? 'selected' : '' %>>🛣️ Yol</option>
          <option value="mekteb" <%= news && news.category === 'mekteb' ? 'selected' : '' %>>🏫 Məktəb</option>
          <option value="su" <%= news && news.category === 'su' ? 'selected' : '' %>>💧 Su</option>
          <option value="isiq" <%= news && news.category === 'isiq' ? 'selected' : '' %>>⚡ İşıq</option>
          <option value="temizlik" <%= news && news.category === 'temizlik' ? 'selected' : '' %>>🧹 Təmizlik</option>
          <option value="diger" <%= news && news.category === 'diger' ? 'selected' : '' %>>📌 Digər</option>
        </select>
      </div>
      <div class="form-group">
        <label>Mətn</label>
        <textarea name="content" rows="8" required><%= news ? news.content : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Yer</label>
        <input type="text" name="location" value="<%= news ? news.location : '' %>">
      </div>
      <div class="form-group">
        <label>Şəkil</label>
        <input type="file" name="image" accept="image/*">
        <% if (news && news.image) { %>
        <div class="current-file"><img src="<%= news.image %>" alt=""><small>Cari şəkil</small></div>
        <% } %>
      </div>
      <div class="form-group">
        <label>Video</label>
        <input type="file" name="video" accept="video/*">
        <% if (news && news.video) { %>
        <div class="current-file"><video src="<%= news.video %>" controls></video><small>Cari video</small></div>
        <% } %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">💾 Yadda saxla</button>
        <a href="/admin/news" class="btn">← Geri</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>