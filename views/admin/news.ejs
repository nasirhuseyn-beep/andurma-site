<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title>Xəbərlər - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news" class="active">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>📰 Xəbərlər</h1>
      <a href="/admin/news/new" class="btn btn-primary">➕ Yeni Xəbər</a>
    </div>
    <% if (news && news.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr><th>Şəkil</th><th>Başlıq</th><th>Kateqoriya</th><th>Baxış</th><th>Tarix</th><th>Əməliyyatlar</th></tr>
      </thead>
      <tbody>
        <% news.forEach(item => { %>
        <tr>
          <td><% if (item.image) { %><img src="<%= item.image %>" class="admin-thumb" alt=""><% } else { %><span class="admin-no-image">📰</span><% } %></td>
          <td><strong><%= item.title %></strong></td>
          <td><span class="badge-cat cat-<%= item.category %>"><%= item.category %></span></td>
          <td>👁️ <%= item.views || 0 %></td>
          <td><%= new Date(item.created_at).toLocaleDateString('az-AZ') %></td>
          <td>
            <div class="actions">
              <a href="/admin/news/edit/<%= item.id %>" class="btn btn-sm btn-warn">✏️</a>
              <form method="POST" action="/admin/news/delete/<%= item.id %>" style="display:inline;" onsubmit="return confirm('Əminsiniz?')">
                <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
      <p class="empty-message">Hələ xəbər yoxdur.</p>
    <% } %>
  </main>
</div>
</body>
</html>