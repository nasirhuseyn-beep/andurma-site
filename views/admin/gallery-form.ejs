<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni foto/video — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <div class="admin-brand">🌿 Andurma</div>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/news">📰 Xəbərlər</a>
      <a href="/admin/articles">📝 Məqalələr</a>
      <a href="/admin/koshe">✍️ Köşə</a>
      <a href="/admin/gallery" class="active">📸 Qalereya</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/messages">📧 Mesajlar</a>
      <% if (user && user.role === 'super_admin') { %>
        <a href="/admin/users">👥 İstifadəçilər</a>
        <a href="/admin/settings">⚙️ Sazlamalar</a>
      <% } %>
      <a href="/admin/password">🔒 Şifrə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1>➕ Yeni foto/video</h1>

      <form method="POST" enctype="multipart/form-data" class="post-form"
            action="/admin/gallery/new">

        <div class="form-group">
          <label>Başlıq *</label>
          <input type="text" name="title" placeholder="Şəklin adı..." required>
        </div>

        <div class="form-group">
          <label>Təsvir (optional)</label>
          <textarea name="description" rows="3" placeholder="Qısa təsvir..."></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>📷 Şəkil</label>
            <input type="file" name="image" accept="image/*">
          </div>

          <div class="form-group">
            <label>🎥 Və ya video</label>
            <input type="file" name="video" accept="video/*">
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">✅ Əlavə et</button>
          <a href="/admin/gallery" class="btn">❌ Ləğv et</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>