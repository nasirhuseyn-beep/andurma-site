<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <title>Görməli Yerlər - Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="admin-wrap">
  <aside class="admin-sidebar">
    <div class="admin-brand">🌿 Andurma</div>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/news">📰 Xəbərlər</a>
    <a href="/admin/articles">📝 Məqalələr</a>
    <a href="/admin/koshe">✍️ Köşə</a>
    <a href="/admin/gallery">🖼️ Qalereya</a>
    <a href="/admin/places" class="active">🗺️ Görməli Yerlər</a>
    <a href="/admin/comments">💬 Şərhlər</a>
    <a href="/admin/messages">📧 Mesajlar</a>
    <a href="/admin/users">👥 İstifadəçilər</a>
    <a href="/admin/settings">⚙️ Sazlamalar</a>
    <a href="/admin/password">🔒 Şifrə</a>
    <a href="/" target="_blank">🌐 Sayta bax</a>
    <a href="/admin/logout">🚪 Çıxış</a>
  </aside>
  <main class="admin-main">
    <div class="admin-header">
      <h1>🗺️ Görməli Yerlər</h1>
      <a href="/admin/places/new" class="btn btn-primary">➕ Yeni Yer</a>
    </div>
    <% if (places && places.length > 0) { %>
    <div class="admin-gallery-grid">
      <% places.forEach(item => { %>
      <div class="admin-gallery-item">
        <% if (item.image) { %><img src="<%= item.image %>" alt=""><% } else { %><div class="admin-no-image">🗺️</div><% } %>
        <div class="admin-gallery-info">
          <strong><%= item.title %></strong>
          <small><%= item.location || '' %></small>
          <small>👁️ <%= item.views || 0 %> baxış</small>
          <% if (item.youtube_link) { %><small>📺 YouTube video var</small><% } %>
        </div>
        <div class="admin-gallery-delete">
          <div class="actions">
            <a href="/admin/places/edit/<%= item.id %>" class="btn btn-sm btn-warn">✏️</a>
            <form method="POST" action="/admin/places/delete/<%= item.id %>" style="display:inline;" onsubmit="return confirm('Əminsiniz?')">
              <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
      <p class="empty-message">Hələ görməli yer yoxdur.</p>
    <% } %>
  </main>
</div>
</body>
</html>