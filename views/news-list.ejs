<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xəbərlər — <%= settings.site_name || 'Andurma Kəndi' %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="site-logo">
        <div class="logo-text">
          <span class="logo-name"><%= settings.site_name || 'Andurma Kəndi' %></span>
          <span class="logo-tagline">Qəbələ rayonu</span>
        </div>
      </a>
      <nav class="main-nav" id="mainNav">
        <a href="/">Ana səhifə</a>
        <a href="/xeberler" class="active">Xəbərlər</a>
        <a href="/isler">Görülən işlər</a>
        <a href="/meqaleler">Məqalələr</a>
        <a href="/koshe">Köşə</a>
        <a href="/qalereya">Qalereya</a>
        <a href="/haqqinda">Haqqında</a>
        <a href="/elaqe">Əlaqə</a>
      </nav>
      <button class="mobile-menu-btn" id="mobileMenuBtn"><span></span><span></span><span></span></button>
    </div>
  </header>

  <section class="page-header">
    <div class="container">
      <h1>📰 Xəbərlər</h1>
      <p>Andurma kəndində baş verən son xəbərlər</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="category-filter">
        <a href="/xeberler" class="filter-btn <%= !category ? 'active' : '' %>">Hamısı</a>
        <a href="/xeberler/yol" class="filter-btn <%= category === 'yol' ? 'active' : '' %>">🛣️ Yol</a>
        <a href="/xeberler/mekteb" class="filter-btn <%= category === 'mekteb' ? 'active' : '' %>">🏫 Məktəb</a>
        <a href="/xeberler/su" class="filter-btn <%= category === 'su' ? 'active' : '' %>">💧 Su</a>
        <a href="/xeberler/isiq" class="filter-btn <%= category === 'isiq' ? 'active' : '' %>">⚡ İşıq</a>
        <a href="/xeberler/temizlik" class="filter-btn <%= category === 'temizlik' ? 'active' : '' %>">🧹 Təmizlik</a>
      </div>

      <% if (news && news.length > 0) { %>
        <div class="news-grid">
          <% news.forEach(item => { %>
            <article class="news-card">
              <a href="/xeber/<%= item.id %>" class="news-card-link">
                <div class="news-card-image">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="<%= item.title %>">
                  <% } else { %>
                    <div class="news-placeholder">📰</div>
                  <% } %>
                  <span class="news-category cat-<%= item.category %>">
                    <%= item.category === 'yol' ? '🛣️ Yol' : 
                        item.category === 'mekteb' ? '🏫 Məktəb' : 
                        item.category === 'su' ? '💧 Su' : 
                        item.category === 'isiq' ? '⚡ İşıq' : 
                        item.category === 'temizlik' ? '🧹 Təmizlik' : '📌 Digər' %>
                  </span>
                </div>
                <div class="news-card-content">
                  <h3 class="news-card-title"><%= item.title %></h3>
                  <p class="news-card-excerpt"><%= item.content.substring(0, 120) %>...</p>
                  <div class="news-card-footer">
                    <span>📅 <%= new Date(item.created_at).toLocaleDateString('az-AZ') %></span>
                    <span>👁️ <%= item.views || 0 %></span>
                  </div>
                </div>
              </a>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-message">Bu kateqoriyada xəbər yoxdur.</p>
      <% } %>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-bottom">
        <p><%= settings.footer_text || '© 2026 Andurma Kəndi' %></p>
        <a href="/admin/login" class="admin-link">Admin girişi</a>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('mobileMenuBtn')?.addEventListener('click', function() {
      document.getElementById('mainNav').classList.toggle('active');
      this.classList.toggle('active');
    });
  </script>
</body>
</html>