<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - <%= settings.site_name || 'Andurma Kəndi' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <% if (gaId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaId %>');
  </script>
  <% } %>
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo">
      <% if (settings.logo) { %><img src="<%= settings.logo %>" alt="Logo" class="logo-img"><% } %>
      <div class="logo-text">
        <span class="logo-name"><%= settings.site_name || 'Andurma Kəndi' %></span>
        <span class="logo-tagline"><%= settings.site_tagline || 'QƏBƏLƏ RAYONU' %></span>
      </div>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/">Ana səhifə</a>
      <a href="/xeberler">Xəbərlər</a>
      <a href="/isler">Görülən işlər</a>
      <a href="/meqaleler" class="active">Məqalələr</a>
      <a href="/koshe">Köşə</a>
      <a href="/qalereya">Qalereya</a>
      <a href="/gormeli-yerler">Görməli yerlər</a>
      <a href="/haqqinda">Haqqında</a>
      <a href="/elaqe">Əlaqə</a>
    </nav>
    <button class="mobile-menu-btn" id="mobileMenuBtn"><span></span><span></span><span></span></button>
  </div>
</header>

<section class="single-content">
  <div class="container-narrow">
    <div class="breadcrumb">
      <a href="/">Ana səhifə</a> / <a href="/meqaleler">Məqalələr</a> / <%= article.title %>
    </div>
    <h1 class="single-title"><%= article.title %></h1>
    <div class="single-meta">
      <span>✍️ <%= article.author_name %></span>
      <span>📅 <%= new Date(article.created_at).toLocaleDateString('az-AZ') %></span>
      <span>👁️ <%= article.views || 0 %> baxış</span>
    </div>

    <% if (article.image) { %><img src="<%= article.image %>" alt="<%= article.title %>" class="single-image"><% } %>

    <div class="single-text"><%= article.content %></div>

    <div class="like-section">
      <button class="like-btn" onclick="likeArticle(<%= article.id %>)">
        <span class="like-icon">❤️</span>
        <span>Bəyən</span>
        <span class="like-count" id="likeCount"><%= article.likes || 0 %></span>
      </button>
    </div>

    <div class="comments-section">
      <h3>💬 Şərhlər (<%= comments.length %>)</h3>
      <% if (comments.length > 0) { %>
        <% comments.forEach(c => { %>
          <div class="comment">
            <div class="comment-head">
              <strong><%= c.name %></strong>
              <small><%= new Date(c.created_at).toLocaleDateString('az-AZ') %></small>
            </div>
            <p><%= c.text %></p>
          </div>
        <% }) %>
      <% } else { %>
        <p class="empty-message">Hələ şərh yoxdur. İlk şərhi siz yazın!</p>
      <% } %>
      <div class="comment-form">
        <h4>Şərh yaz</h4>
        <% if (sent) { %><div class="ok">✅ Şərhiniz göndərildi! Təsdiqləndikdən sonra görünəcək.</div><% } %>
        <form method="POST" action="/comment/article/<%= article.id %>">
          <input type="text" name="name" placeholder="Adınız *" required>
          <textarea name="text" rows="4" placeholder="Şərhiniz *" required></textarea>
          <button type="submit" class="btn btn-primary">Göndər</button>
        </form>
      </div>
    </div>
    <a href="/meqaleler" class="back-link">← Bütün məqalələr</a>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-bottom">
      <p><%= settings.footer_text || '© 2026 Andurma Kəndi — Bütün hüquqlar qorunur.' %></p>
      <a href="/admin/login" class="admin-link">Admin girişi</a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('mobileMenuBtn').addEventListener('click', function() {
    document.getElementById('mainNav').classList.toggle('active');
    this.classList.toggle('active');
  });
  function likeArticle(id) {
    fetch('/like/article/' + id, { method: 'POST' })
      .then(r => r.json())
      .then(data => { if (data.success) document.getElementById('likeCount').textContent = data.likes; });
  }
</script>
</body>
</html>